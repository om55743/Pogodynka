{% extends 'base.html.twig' %}

{% block title %}Weather Forecast – Open-Meteo{% endblock %}

{% block body %}
    <h1>Weather Forecast</h1>

    {{ form_start(form) }}
    {{ form_widget(form) }}
    <button type="submit" class="btn btn-primary">Submit</button>
    {{ form_end(form) }}

    {% if error %}
        <div class="alert alert-danger mt-3">{{ error }}</div>
    {% endif %}

    {% if weather_data %}
        <h2 class="mt-4">Data from Open-Meteo</h2>
        <p>Latitude: {{ weather_data.latitude }}, Longitude: {{ weather_data.longitude }}</p>

        <table class="table table-striped">
            <thead>
            <tr>
                <th>Date</th>
                <th>Max Temperature (°C)</th>
                <th>Min Temperature (°C)</th>
                <th>Precipitation (mm)</th>
            </tr>
            </thead>
            <tbody>
            {% for i in 0..weather_data.daily.time|length - 1 %}
                <tr>
                    <td>{{ weather_data.daily.time[i] }}</td>
                    <td>{{ weather_data.daily.temperature_2m_max[i] }}</td>
                    <td>{{ weather_data.daily.temperature_2m_min[i] }}</td>
                    <td>{{ weather_data.daily.precipitation_sum[i] }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
