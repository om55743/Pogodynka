{% extends 'base.html.twig' %}

{# @var location \App\Entity\Location #}
{# @var forecasts \App\Entity\Forecast[] #}

{% block title %}Weather in {{ location.name }}, {{ location.country }}{% endblock %}

{% block body %}
    <h1>Weather in {{ location.name }}, {{ location.country }}</h1>

    <table class="table table-striped">
        <thead>
        <tr>
            <th>Date</th>
            <th>Temperature (°C)</th>
            <th>Humidity (%)</th>
            <th>Chance for precipitation (%)</th>
            <th>Wind (m/s)</th>
        </tr>
        </thead>
        <tbody>
        {% for forecast in forecasts %}
            <tr>
                <td>{{ forecast.Date|date('d.m.Y') }}</td>
                <td>{{ forecast.Temperature }}</td>
                <td>{{ forecast.Humidity }}</td>
                <td>{{ forecast.Rain }}</td>
                <td>{{ forecast.Wind }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">No forecasts available.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
